# 复制为 .env 后按需修改
# cp .env.example .env

# ---- 搜索 ----
TAVILY_API_KEY=tvly-xxxxxxxx

# ---- LLM（OpenAI 兼容）----
LLM_PROVIDER=custom
LLM_MODEL_ID=deepseek-flash
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com

# ---- 研究行为 ----
MAX_WEB_RESEARCH_LOOPS=3
FETCH_FULL_PAGE=True

# ---- 笔记 ----
ENABLE_NOTES=True
NOTES_WORKSPACE=./notes

# ---- Agent 行为 ----
# True  → 总结阶段使用真正的 ReAct Agent（create_react_agent + 工具）
# False → 纯 LLM 流式总结（默认，更稳更快）
#
# ⚠️ 想要 Agent 主动调用工具（笔记工具 / 本地知识库检索），这个必须是 True。
USE_TOOL_CALLING=False
STRIP_THINKING_TOKENS=True

# ---- 本地知识库 RAG ----
# 开启前先建索引（在 langgraph/ 目录下执行）：python src/knowledge_indexer.py
ENABLE_RAG=False
KNOWLEDGE_BASE_DIR=./data/docs
VECTOR_STORE_DIR=./data/chroma
RAG_COLLECTION=local_knowledge
RAG_TOP_K=3
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# Embedding 模式：local（本地模型，离线，需装 torch）/ openai（OpenAI 兼容接口）
# ⚠️ DeepSeek 没有 embeddings 接口，openai 模式不能复用上面的 LLM_BASE_URL
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
